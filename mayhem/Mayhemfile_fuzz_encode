project: savantenvs/jiffy
target: fuzz_encode
testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
  - file://mayhem/fuzz_encode/testsuite
cmds:
  - cmd: /mayhem/fuzz_encode
    libfuzzer: true
    timeout: 30
    dictionary: /mayhem/mayhem/fuzz_encode/fuzz_encode.dict
    env:
      MFUZZ_COMPAT_LEVEL: '2'
